{
  // Cloudflare Workers, free plan.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "order-limits",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    // Only these reach the code above and count towards the free daily limit.
    // Everything else (scripts, styles, images) is served free and without limit.
    "run_worker_first": ["/", "/index.html", "/api/*", "/webhooks"]
  },
  "vars": {
    // The app's Client ID from the Dev Dashboard. Public, so it can live here.
    "SHOPIFY_API_KEY": "00000000000000000000000000000000",
    // The app's handle (the end of its Dev Dashboard URL), for the "See plans" button.
    "APP_HANDLE": "",
    // Set this to show every merchant a message, for example during maintenance.
    "SERVICE_NOTICE": ""
  },
  "observability": { "enabled": true }
  // SHOPIFY_API_SECRET is a secret, set by the deploy workflow, never written here.
}
